# 이 파일을 복사해서 `.env` 로 이름을 바꾸고 값을 채우세요.
#
#   copy .env.example .env
#
# `.env` 는 .gitignore 에 들어 있어 깃에 올라가지 않습니다.
# 봇 토큰이 깃에 올라가면 누구나 봇을 조종할 수 있으니 절대 커밋하지 마세요.
#
# 채운 뒤 build_bot_zip.py 를 실행하면 .env 가 zip 에 함께 담깁니다.
# (Discloud 대시보드에 직접 넣어도 결과는 같습니다)


# ── AI 키 ─────────────────────────────────────────────────────
# 자유로운 문장을 알아듣게 해줍니다. 디스코드 봇과 웹 챗봇이 함께 씁니다.
# 없어도 "1번 세탁기 알림 걸어줘" 같은 자주 쓰는 말은 규칙으로 처리됩니다.
#
# 키는 반드시 이 파일(.env)에만 둡니다.
# app.js 같은 프런트엔드 파일에 적으면 사이트에 들어온 누구나 받아 갑니다.
# 실제로 그렇게 새서 폐기 통보를 받은 적이 있습니다.
# 브라우저는 /api/ai/... 로 서버에 물어보고, 키는 서버가 붙입니다.
GEMINI_API_KEY=

# 키를 여러 개 가지고 있으면 아래처럼 더 넣을 수 있습니다.
# 한 키가 하루 한도(429)에 걸리면 자동으로 다음 키로 넘어갑니다.
#
# ⚠️ 같은 구글 프로젝트에서 만든 키끼리는 한도를 같이 씁니다. 효과가 없습니다.
#    반드시 서로 다른 계정 또는 프로젝트에서 받은 키를 넣으세요.
#
# 방법 1) 번호를 붙여 따로 넣기 (_2 부터 _8 까지)
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
#
# 방법 2) 한 줄에 쉼표로 이어 넣기 (위 GEMINI_API_KEY 에 넣어도 됩니다)
# GEMINI_API_KEYS=키1,키2,키3


# ── 상태 저장소 (Render 에서는 사실상 필수) ──────────────────
# Render 는 재배포·재시작마다 파일이 지워집니다.
# 이걸 설정하지 않으면 배포할 때마다
#   · 학생들이 걸어둔 알림이 전부 사라지고
#   · /채널설정 으로 정한 대화 채널도 풀립니다.
#
# https://upstash.com 에서 무료 Redis 를 만들고(가입 후 1분),
# 대시보드의 REST API 항목에 있는 두 값을 그대로 붙여넣으세요.
# 설치할 패키지는 없습니다. 그냥 HTTP 요청만 씁니다.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# 같은 저장소를 여러 봇이 나눠 쓸 때만 바꾸면 됩니다. 보통은 비워둡니다.
STATE_PREFIX=


# ── 웹 서버와 봇을 한곳에서 돌릴 때 ───────────────────────────
# start_server.py 가 봇도 함께 띄웁니다.
# 웹만 돌리고 싶으면 0 으로 두세요.
RUN_DISCORD_BOT=


# ── 관리자 모드 (선택) ────────────────────────────────────────
# 운영자가 시험할 때 주제 제한 없이 물어볼 수 있게 합니다.
# 둘 다 채워야 켜집니다. 하나라도 비면 기능 자체가 꺼집니다.
#
# 1) 내 디스코드 사용자 ID (숫자)
#    디스코드 설정 > 고급 > 개발자 모드를 켜고,
#    내 프로필을 오른쪽 클릭 > "사용자 ID 복사"
#    쉼표로 여러 명을 넣을 수도 있습니다.
ADMIN_USER_IDS=
#
# 2) 암구호. 평소 대화에 절대 안 나올 말로 정하세요.
#    "관리자/개발자/디버그/테스트" + "모드/권한" 조합은 피하세요.
#    (탈옥 방어에 먼저 걸려서 본인도 못 씁니다)
#    예) 정글열쇠 / 세탁의신 / 북극곰세탁
#    어디서 말해도 됩니다. 진짜 자물쇠는 위의 사용자 ID 라서,
#    남이 암구호를 알아도 쓸 수 없습니다.
#    답변 중 API 키·토큰·푸시 구독 주소·암구호·관리자 ID 가 섞인 것만
#    자동으로 개인 DM 으로 보내고, 그 밖의 내용은 그냥 채널에 올립니다.
ADMIN_PASSPHRASE=


# ── 예비 엔진 (선택) ──────────────────────────────────────────
# 제미나이 키가 모두 막혔을 때만 씁니다. 다른 회사라 할당량이 완전히 따로입니다.
# https://console.groq.com 에서 무료로 받을 수 있습니다.
GROQ_API_KEY=

# ── 멘션 없이 채널에서 그냥 말 걸고 싶을 때만 ────────────────────
# 1) Discord 개발자 포털 > Bot > MESSAGE CONTENT INTENT 를 먼저 켜야 합니다.
#    포털에서 켜지 않고 아래를 1 로 두면 봇이 접속하지 못합니다.
# 2) 어느 채널에서 쓸지는 환경변수가 아니라 디스코드 안에서 정합니다.
#    그 채널에 가서 /채널설정 을 누르면 됩니다. (재배포 불필요)
ENABLE_MESSAGE_CONTENT=


# ── 보통은 건드릴 일이 없는 것 ──────────────────────────────────
# 봇 토큰. Discloud 대시보드에 이미 넣어두셨다면 비워두세요.
# (환경변수가 이미 있으면 .env 값이 덮어쓰지 않습니다)
DISCORD_BOT_TOKEN=

# 세탁 완료 후 몇 초 뒤에 "수거해 가세요" 알림을 보낼지 (기본 900 = 15분)
STALE_PICKUP_SEC=

# 운영 문의처 (선택). 적어두면 AI 가 "모르겠으면 여기로 문의하세요" 라고 안내한다.
# 비워 두면 번호 없이 "담당자에게 문의" 로만 안내한다.
SUPPORT_CONTACT=
